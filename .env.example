# Postgres (used by docker-compose and apps/api)
DATABASE_URL="postgresql://conciliacao:conciliacao@localhost:55432/conciliacao?schema=public"

# apps/api
API_PORT=3001
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"
CORS_ORIGIN="http://localhost:3000"

# Documentação servida pela API: manual em /docs/ledger-manual, Swagger em /docs/api.
# Ligada por padrão; use "false" para esconder (ex.: produção pública).
DOCS_ENABLED="true"
# URL pública da API, usada como servidor no "Try it out" do Swagger quando a doc
# é aberta pelo domínio do web (rewrite /docs → API). Opcional.
API_PUBLIC_URL="http://localhost:3001"

# Google OAuth (opcional — só necessário para "Continuar com Google").
# Obtenha as credenciais no Google Cloud Console e registre a callback URL lá.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"
# Para onde o callback OAuth redireciona o navegador (front-end).
WEB_APP_URL="http://localhost:3000"

# apps/web
NEXT_PUBLIC_API_URL="http://localhost:3001"
